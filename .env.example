# ---------------------------------------------------------------------------
# Aegis Eval - environment configuration
# Every value below has a safe default. No outbound network call is required
# for the platform to start, run evaluations against local targets, or report.
# ---------------------------------------------------------------------------

# Control plane
AEGIS_ENV=development
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_SECRET_KEY=change-me-in-every-deployment
AEGIS_ACCESS_TOKEN_TTL_MINUTES=720

# Persistence. SQLite by default so the platform runs with zero dependencies.
# Postgres example: postgresql+psycopg://aegis:aegis@postgres:5432/aegis
AEGIS_DATABASE_URL=sqlite:///./data/aegis.db

# Evidence store. "file" keeps artifacts on local disk; "s3" targets any
# S3-compatible object store -- MinIO on premises, AWS S3, or DigitalOcean
# Spaces -- inside the customer boundary.
AEGIS_EVIDENCE_BACKEND=file
AEGIS_EVIDENCE_PATH=./data/evidence
AEGIS_S3_ENDPOINT_URL=
AEGIS_S3_BUCKET=
# Required for SigV4 signing. For Spaces this is the Space's region (nyc3,
# ams3, sfo3, fra1, sgp1, syd1). A mismatch fails as SignatureDoesNotMatch,
# which says nothing about the cause.
AEGIS_S3_REGION=us-east-1
AEGIS_S3_ACCESS_KEY=
AEGIS_S3_SECRET_KEY=
# Key prefix, so one bucket can hold several deployments.
AEGIS_S3_PREFIX=

# Set on hosts whose container filesystem does not survive a deploy (App
# Platform, Cloud Run, Heroku). The API then refuses to start on SQLite or a
# local evidence directory, rather than losing both on the next release.
AEGIS_EPHEMERAL_FILESYSTEM=false

# Highest marking this deployment may hold. Empty means no ceiling. Set it on
# infrastructure that is not accredited for a marking, and the API refuses
# artifacts above it instead of relying on operators to remember.
# One of: UNCLASSIFIED, CUI, CONFIDENTIAL, SECRET, TOP SECRET
AEGIS_MAX_CLASSIFICATION=

# Work queue. "inline" executes in-process (single node / air-gapped laptop),
# "redis" fans work out to dedicated worker containers.
AEGIS_QUEUE_BACKEND=inline
AEGIS_REDIS_URL=redis://redis:6379/0
AEGIS_WORKER_CONCURRENCY=4

# Telemetry is OFF unless a customer explicitly points it at their collector.
# The platform never phones home.
AEGIS_TELEMETRY_ENABLED=false
AEGIS_OTLP_ENDPOINT=

# Egress policy. "deny" refuses any connector whose base URL is not on the
# allowlist -- the default posture for disconnected / air-gapped deployments.
AEGIS_EGRESS_POLICY=allow
AEGIS_EGRESS_ALLOWLIST=

# Bootstrap admin for local accounts (development deployments only).
AEGIS_BOOTSTRAP_EMAIL=admin@aegis.local
AEGIS_BOOTSTRAP_PASSWORD=aegis-dev-password
AEGIS_SEED_DEMO=true

# OIDC / enterprise SSO (P0). Leave blank to use local accounts only.
AEGIS_OIDC_ISSUER=
AEGIS_OIDC_CLIENT_ID=
AEGIS_OIDC_CLIENT_SECRET=

# Optional credentials for model connectors. Stored per-system in the app;
# these are development conveniences only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web: product tour -------------------------------------------------------
# Build-time (Next.js inlines NEXT_PUBLIC_*). Unset: on under `npm run dev`, off
# in a production build. With the tour on, it replaces the first-run
# walkthrough; with it off, the walkthrough is unchanged.
# NEXT_PUBLIC_AEGIS_TOUR=1
# Presenter mode (?tour=lead&step=4 and a step picker in the ? menu). Shown
# only to accounts that can administer an organization.
# NEXT_PUBLIC_AEGIS_TOUR_PRESENTER=1
