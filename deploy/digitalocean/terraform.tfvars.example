# Copy to terraform.tfvars and edit. Never commit the real file.
project_name = "aegis-eval"
region       = "nyc3"
environment  = "production"

# Postgres. Two nodes gives a standby for failover.
db_size       = "db-s-1vcpu-1gb"
db_node_count = 1

valkey_size = "db-s-1vcpu-1gb"

# Container registry for the deploy workflow's signed images.
# The name is globally unique across DigitalOcean -- change it on a 409.
# `starter` is free but holds only ONE repository and this pushes two, so
# `basic` (~$5/mo, 5 repositories) is the smallest tier that works.
registry_name = "aegis-eval"
registry_tier = "basic"

# DigitalOcean allows one registry per account. Set false and reuse the
# existing one if this account already has it.
create_registry = true

# Droplet IDs permitted to reach the databases. Leave empty for App Platform.
trusted_sources = []

# App Platform app ID to admit through the database firewall.
app_platform_app_id = ""
